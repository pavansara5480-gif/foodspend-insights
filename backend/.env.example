# Copy to backend/.env (or run scripts\setup_mysql.ps1, which writes it for you).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# mysql (default) or sqlite (quick local fallback, no server needed)
DB_ENGINE=mysql
DB_NAME=foodspend
DB_USER=foodspend
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
